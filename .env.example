# Copy to .env and adjust. .env is git-ignored — never commit real secrets.

# --- docker-compose (Postgres) ---
POSTGRES_USER=dehub
POSTGRES_PASSWORD=dehub
POSTGRES_DB=dehub
POSTGRES_PORT=5432

# --- backend (Go API) ---
APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://dehub:dehub@localhost:5432/dehub?sslmode=disable
